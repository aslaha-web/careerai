# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL 15 or newer. Connection string format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local example:   postgresql://postgres:yourpassword@localhost:5432/careerai
# Hosted free tiers (e.g. Neon, Supabase) give you a string like this in their dashboard;
# if it ends with ?sslmode=require, keep that part.
DATABASE_URL=

# Which proxy headers may be trusted to find the visitor's IP address (used for login/sign-up throttling).
# Forwarding headers can be forged by anyone, so the default is to ignore them.
#   (empty) or none : trust nothing. Login throttling is per email only.   <- local development
#   vercel          : the app is deployed on Vercel.
#   1, 2, 3 ...     : number of proxies YOU control that append to X-Forwarded-For
#                     (nginx or a single load balancer in front of the app = 1).
# Setting this wrongly (for example "vercel" when you are not on Vercel) lets attackers
# forge their IP and weakens the limits. See the README section "Deploying behind a proxy".
TRUST_PROXY=

# Cookies are marked Secure in production. Set to "true" ONLY if you run
# `npm run build && npm start` over plain http://localhost to test locally.
# Leave it false (or unset) on any real deployment.
ALLOW_INSECURE_COOKIES=false

# Public contact page. The contact form opens the visitor's email app addressed to this address
# (nothing is stored on the server). Leave empty and the page shows a "not configured" notice.
CONTACT_EMAIL=
